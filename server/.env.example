# Copy to .env on the VPS. Never commit the real .env file.
FGRCK_DOMAIN=cloud.example.com
FGRCK_ACME_EMAIL=admin@example.com

# Generate independent random values, for example:
# openssl rand -base64 48
POSTGRES_PASSWORD=CHANGE_ME
FGRCK_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_VALUE_AT_LEAST_32_CHARS
FGRCK_TOKEN_PEPPER=CHANGE_ME_TO_ANOTHER_RANDOM_VALUE_AT_LEAST_32_CHARS

FGRCK_JWT_TTL_MINUTES=720
FGRCK_COMMAND_TTL_SECONDS=180
FGRCK_CONTROLLER_ONLINE_SECONDS=90
FGRCK_COMMAND_REDELIVER_SECONDS=30
FGRCK_MAX_COMMAND_ATTEMPTS=5

# Optional email alerts. Leave FGRCK_SMTP_HOST empty to keep email delivery disabled.
# Example values work with any SMTP provider that supports authenticated submission.
FGRCK_SMTP_HOST=
FGRCK_SMTP_PORT=587
FGRCK_SMTP_USER=
FGRCK_SMTP_PASSWORD=
FGRCK_SMTP_FROM=
# starttls | ssl | none
FGRCK_SMTP_SECURITY=starttls
FGRCK_SMTP_TIMEOUT_SECONDS=10
